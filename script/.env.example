RPC_URL=https://rpc.example.com

# ==================================================
# 기본 설정 (선택적)
# ==================================================
INITIAL_DELAY=172800                    # 2일 (초 단위) - 기본값: 86400
ADMIN_ADDRESS=0x...                     # Admin 주소 (기본값: deployer)

# ==================================================
# Implementation 주소 (DeployFullSystem 필수)
# ==================================================
CROSS_GAME_REWARD_ROOT_IMPLEMENTATION=0x...  # CrossGameReward Implementation
POOL_IMPLEMENTATION=0x...                     # Pool V1 Implementation
POOL_V2_IMPLEMENTATION=0x...                  # Pool V2 Implementation (V2 사용 시)

# ==================================================
# Pool 생성 (CreatePool / DeployFullSystem)
# ==================================================
CREATE_POOL=true
POOL_VERSION=1                                # 1=CrossPool(V1), 2=GamePool(V2)
POOL_NAME="Cross Game Reward Pool"
DEPOSIT_TOKEN=0x...                           # 0x1=Native Token(V1 전용), ERC20 주소
MIN_DEPOSIT_AMOUNT=1000000000000000000        # 1 ether

# ==================================================
# V1 Pool 전용 - Reward Token (선택적)
# ==================================================
REWARD_TOKEN=0x...                            # V1: addRewardToken에 사용
                                              # V2: createPoolV2에 필수

# ==================================================
# V2 Pool 전용 (선택적)
# ==================================================
SPONSOR_ADDRESS=0x...                         # 라운드 생성 권한 부여할 스폰서 지갑

# ==================================================
# 업그레이드 (UpgradePools)
# ==================================================
CROSS_GAME_REWARD=0x...                       # CrossGameReward Proxy 주소
NEW_POOL_IMPLEMENTATION=0x...                 # 새 구현체 주소
# REINIT_DATA=0x...                           # reinitializer calldata (선택적)

# ==================================================
# Manager Role Hash (참고용)
# ==================================================
# 0x241ecf16d79d0f8dbfb92cbc07fe17840425976cf0667f022fe9877caa831b08
